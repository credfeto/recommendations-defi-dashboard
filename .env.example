# Copy to .env and replace the placeholder values: cp .env.example .env
# Never commit .env; it holds real credentials and is ignored by git.
# .NET configuration keys are case-insensitive, so these uppercase names bind to
# DatabaseConfiguration:ConnectionString and Rpc:<Chain> in appsettings.json.

DATABASECONFIGURATION__CONNECTIONSTRING="Server=<sql-server-host>;User ID=<sql-user>;Password=<sql-password>;Database=<database-name>;TrustServerCertificate=true;Application Name=Defi"

# Optional: override the default public RPC endpoints from appsettings.json
# RPC__ETHEREUM="<ethereum-rpc-url>"
# RPC__ARBITRUM="<arbitrum-rpc-url>"
# RPC__BASE="<base-rpc-url>"
# RPC__BSC="<bsc-rpc-url>"
